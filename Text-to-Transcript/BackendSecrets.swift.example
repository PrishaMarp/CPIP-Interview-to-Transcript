//
//  BackendSecrets.swift.example
//  Text-to-Transcript
//
//  Setup:
//  1. Copy this file to BackendSecrets.swift (same folder)
//  2. Paste your Supabase project URL and anon (publishable) key
//  3. BackendSecrets.swift is gitignored — do not commit it
//
//  The anon key is safe to ship in the app. Security comes from RLS policies.
//  Never put service-role keys or OpenAI keys in the iOS app.
//

import Foundation

enum BackendSecrets {
    static let supabaseURL = URL(string: "https://YOUR_PROJECT.supabase.co")!
    static let supabaseAnonKey = "YOUR_ANON_KEY"
}
